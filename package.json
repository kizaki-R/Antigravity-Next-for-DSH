{
  "name": "agy-next",
  "version": "0.3.2",
  "description": "From-scratch Antigravity / Cloud Code Assist provider for DeepSeek Harness — bring your own OAuth client",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/ui.js",
    "./config": "./lib/config.js",
    "./client-config": "./lib/client-config.js",
    "./i18n": "./lib/i18n.js",
    "./setup-guide": "./lib/setup-guide.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "SETUP.md",
    "LICENSE",
    "icon.svg"
  ],
  "bin": {
    "agy-next-login": "bin/login.mjs"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/ui.js && node --check lib/config.js && node --check lib/client.js && node --check lib/client-config.js && node --check lib/status.js && node --check lib/web-api.js && node --check lib/i18n.js && node --check lib/setup-guide.js && node --check lib/constants.js && node --check lib/convert.js && node --check lib/oauth.js && node --check lib/store.js && node --check lib/stream.js && node --check bin/login.mjs && node --check bin/smoke.mjs",
    "verify": "node bin/check-offline.mjs",
    "smoke": "node bin/smoke.mjs",
    "tools": "node bin/test-tools.mjs",
    "routing": "node bin/verify-routing.mjs",
    "sweep": "node bin/sweep-models.mjs",
    "login": "node bin/login.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.3.0",
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/dsh-timeout": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "antigravity",
    "cloud-code-assist",
    "gemini",
    "llm",
    "provider"
  ],
  "license": "MIT"
}
